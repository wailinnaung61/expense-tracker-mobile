# API Configuration
# Backend API base URL (without /api suffix, it's added automatically in api.ts)
EXPO_PUBLIC_API_BASE_URL=http://localhost:5038

# For production deployment, change to your production API URL:
# EXPO_PUBLIC_API_BASE_URL=https://your-api.com

# AWS S3 Configuration (if using receipt upload feature)
# EXPO_PUBLIC_AWS_REGION=us-east-1
# EXPO_PUBLIC_S3_BUCKET=your-bucket-name
